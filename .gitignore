# ---- Build artifacts ----
# Compiled binaries (server / client)
/gop2pmesh-server
/gop2pmesh-client
/gop2pmesh-server.exe
/gop2pmesh-client.exe
*.exe
*.dll
*.so
*.dylib
# Exclude test/coverage output
*.test
*.out
coverage.txt

# ---- Runtime data ----
# SQLite databases (server: data/gop2pmesh.db, client: portcontrol.db)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Secrets & certificates (never commit) ----
# Server API certs, root signing key, client identity key
*.crt
*.key
*.pem
*.p12
*.pfx

# ---- Logs ----
*.log
logs/

# ---- Local configuration ----
# Only *.example files belong in the repo; real configs hold secrets
server.ini
client.ini

# ---- Platform runtime ----
# Windows TUN driver, released to %LOCALAPPDATA%\gop2pmesh\
wintun.dll

# ---- Tooling / editor / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
